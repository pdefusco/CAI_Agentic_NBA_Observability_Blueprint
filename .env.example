# Copy this file to .env and fill in your values.

# --- Cloudera AI Inference Service — Nemotron LLM endpoint ---
LLM_MODEL_ID=nemotron
LLM_ENDPOINT_BASE_URL=https://<your-inference-service>/openai/v1
LLM_CDP_TOKEN=<your CDP token>

# --- Cloudera AI Inference Service — XGBoost fraud classifier endpoint ---
CLF_MODEL_ID=xgboost
CLF_ENDPOINT_BASE_URL=https://<your-inference-service>
CLF_CDP_TOKEN=<your CDP token>

# --- Behavior ---
FRAUD_THRESHOLD=0.5
NBA_DB_PATH=./nba_demo.db
NBA_CUSTOMER_ROWS=10000
# Set NBA_MOCK=1 to skip the live LLM / XGBoost endpoints during local testing.
# NBA_MOCK=1

# --- LangSmith ---
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=<your LangSmith key>
LANGSMITH_PROJECT=nba-demo
# Used only to render one-click "open in LangSmith" links in the app sidebar:
LANGSMITH_ORG=<your LangSmith org slug or uuid>

# --- CAI project owner (used to name the DB / trace metadata) ---
PROJECT_OWNER=demo_user
